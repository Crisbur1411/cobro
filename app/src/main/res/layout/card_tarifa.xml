<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardTarifa"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/borde_btn_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:layout_marginBottom="40dp">

    <!-- Ícono -->
    <ImageView
        android:id="@+id/iconTarifa"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/persona"
        android:layout_marginEnd="8dp" />

    <!-- Botón Menos -->
    <Button
        android:id="@+id/btnMenosTarifa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="-"
        android:textSize="18sp"
        android:background="@drawable/menos"
        android:backgroundTint="@color/white"
        android:layout_marginEnd="8dp" />



    <!-- Info de tarifa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreTarifa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrecioTarifa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Botón Más -->
    <Button
        android:id="@+id/btnMasTarifa"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="+"
        android:textSize="18sp"
        android:background="@drawable/mas"
        android:layout_marginStart="8dp" />

</LinearLayout>


